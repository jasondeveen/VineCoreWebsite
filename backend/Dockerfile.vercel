# Build stage: restore and publish the .NET app.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . ./
# Drop any build artifacts copied from the local machine. A Windows obj/
# records a Visual Studio fallback-package path that breaks restore on Linux,
# so clear it and let `dotnet publish` restore from scratch.
RUN rm -rf obj bin && dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage: full ASP.NET image (includes CA certs + ICU, needed for SMTP over TLS).
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish ./
ENV PORT=80 DOTNET_EnableDiagnostics=0
ENTRYPOINT ["dotnet", "VineCore.Api.dll"]
